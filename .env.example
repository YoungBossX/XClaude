# XClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
X_HOST=127.0.0.1
X_PORT=7437

# ── Logging ───────────────────────────────────────────────────
X_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
X_LOG_FILE=~/.x/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
X_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# X_CONFIG=~/.x/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# X_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# X_MAX_STEPS=20
