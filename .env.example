# XClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
X_HOST=127.0.0.1
X_PORT=7437

# ── Logging ───────────────────────────────────────────────────
X_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
X_LOG_FILE=~/.x/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
X_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# X_CONFIG=~/.x/config.toml

# ── LLM ───────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# X_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# 兼容模型的真实窗口请以供应商说明为准；此项用于水位和压缩预算
# X_CONTEXT_WINDOW=200000
# X_MAX_STEPS=20

# ── Task Resources ────────────────────────────────────────────
# daemon 共享的同时模型请求上限（包含自动和手动压缩）
# X_MAX_CONCURRENT_LLM=4
# 单棵任务树总任务数（含根任务）
# X_MAX_TASKS=32
# 单棵任务树总 Token 预算；0 禁用，失败请求保留估算消费
# X_MAX_TOTAL_TOKENS=500000
# 单棵任务树墙钟秒数（包含排队及重启离线时间）；0 禁用
# X_MAX_RUNTIME_S=1800

# ── Context Compaction ────────────────────────────────────────
# 默认达到 80% 时自动压缩，设为 0 可关闭；也可随时使用 /compact
# X_COMPACT_THRESHOLD=0.8
